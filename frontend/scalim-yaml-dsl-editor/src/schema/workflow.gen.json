                "properties": {
                  "budget": {
                    "type": "object",
                    "required": [
                      "max_sheets",
                      "max_total_cells"
                    ],
                    "properties": {
                      "max_sheets": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "sheetbook budget: max_sheets(正整数)",
                        "markdownDescription": "sheetbook budget: `max_sheets`(正整数).",
                        "examples": [
                          32
                        ]
                      },
                      "max_total_cells": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "sheetbook budget: max_total_cells(正整数)",
                        "markdownDescription": "sheetbook budget: `max_total_cells`(正整数).",
                        "examples": [
                          5000000
