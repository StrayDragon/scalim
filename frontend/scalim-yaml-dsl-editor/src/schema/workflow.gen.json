                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "csv 输出路径(非空字符串)",
                    "markdownDescription": "csv 输出路径(非空字符串).",
                    "examples": [
                      "./out/report.csv"
                    ]
                  }
                },
                "additionalProperties": false
