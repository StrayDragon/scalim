                        "markdownDescription": "导出 xlsx 路径(非空字符串).",
                        "examples": [
                          "./out/report.xlsx"
                        ]
                      },
                      "write_lock": {
                        "type": "boolean",
                        "default": false,
                        "description": "导出阶段启用写锁(可选)",
                        "markdownDescription": "导出阶段启用写锁(可选).",
                        "examples": [
                          true
                        ]
                      },
                      "allow_formulas": {
                        "type": "boolean",
                        "default": false,
                        "description": "允许公式(可信输入显式放宽,将禁用公式前缀转义)",
                        "markdownDescription": "允许公式(可信输入显式放宽,将禁用公式前缀转义).",
                        "examples": [
                          true
                        ]
                      }
                    },
                    "additionalProperties": false
