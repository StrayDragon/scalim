kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  modify_requirement,r23,"xlsx spreadsheet books MUST use typed managed-artifact pipeline","When a workflow-managed demand output is bound to a shared book whose kind is `xlsx_file` or `xlsx_memory`, the system MUST materialize that output as `MANAGED_ARTIFACT_KIND_ROWS` (`InMemoryRows`) and MUST set the composed `OutputSpec.format` to `excel`. The pipeline MUST preserve `FieldValue` semantics (`int`/`float`/`Decimal`/`bool`/`str`/`None`/`datetime`/`date`) through write-node consumption and workbook/sheetbook planning, and MUST NOT first stringify via `InMemoryCsvSink` / `_normalize_csv_value()` for those book kinds. `datetime` MAY be timezone-aware in the typed pipeline; at the final openpyxl append/export boundary the system MUST normalize aware `datetime` by clearing `tzinfo` (openpyxl does not support timezones). Write nodes for `resource_type=book` with xlsx kinds and legacy `resource_type=workbook` MUST resolve inputs via `resolve_workflow_input_tabular()`. At the final openpyxl append/export boundary, non-`str` values MUST be passed through after that normalization (formula escaping applies to `str` only). `None` MUST NOT be converted to `''` solely because the destination is `xlsx_file`. Heuristic `_auto_cast` / guess-casting from strings MUST NOT be introduced as the recovery path for numeric or temporal typing.",null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  r23,"xlsx-rows-preserve-datetime","workflow-managed xlsx_file output contains datetime create_datetime",run completes and workbook is committed,"Excel cell MUST be a date/datetime value (not a stringified text cell solely due to CSV middle-layer)"
  r23,"xlsx-rows-normalize-aware-datetime","workflow-managed xlsx output contains timezone-aware datetime",write/commit path runs,"system MUST clear tzinfo at the openpyxl boundary and still produce a valid workbook"
