kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  add_requirement,r8,xlsx_memory budget guards MUST read Python BookBudgetPolicy,xlsx_memory 预算护栏 MUST 从 effective Python BookBudgetPolicy 读取并强制执行；YAML xlsx_memory.budget authoring MUST 已被拒绝（依赖上游 book-write-policy-python-ssot）。未提供 policy 时 MUST 视为 unlimited。其余 sheetbook typed/export/canonical-key 契约保持不变。,null,null,null
op_scenarios[1]{req_id,id,given,when,then}:
  r8,"budget-from-python-not-yaml","YAML 无 budget 且 Python 提供 BookBudgetPolicy(max_total_cells=1)",写入导致 cell 超限,"系统 MUST fail-fast"
