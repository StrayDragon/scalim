kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  modify_requirement,r393,"xlsx spreadsheet books MUST use typed managed-artifact pipeline","When a workflow-managed demand output is bound to a shared book whose kind is `xlsx_file` or `xlsx_memory` (or unified `xlsx`), the system MUST materialize that output as `MANAGED_ARTIFACT_KIND_ROWS` (`InMemoryRows`) and MUST set the composed `OutputSpec.format` to `excel`. The pipeline MUST preserve `FieldValue` semantics (`int`/`float`/`Decimal`/`bool`/`str`/`None`/`datetime`/`date`/`time`/`timedelta`) through write-node consumption and workbook/sheetbook planning, and MUST NOT first stringify via `InMemoryCsvSink` / `_normalize_csv_value()` for those book kinds. Temporal values MUST be passed through unchanged in the typed pipeline (including timezone-aware instances); the system MUST NOT clear `tzinfo` or otherwise rewrite user temporal values for Excel compatibility. Write nodes for `resource_type=book` with xlsx kinds and legacy `resource_type=workbook` MUST resolve inputs via `resolve_workflow_input_tabular()`. At the final openpyxl append/export boundary, non-`str` values MUST be passed through (formula escaping applies to `str` only); openpyxl rejection of timezone-aware values MUST surface as an error rather than silent stringification. `None` MUST NOT be converted to `''` solely because the destination is an xlsx book. Heuristic `_auto_cast` / guess-casting from strings MUST NOT be introduced as the recovery path for numeric or temporal typing.",null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  r393,"xlsx-rows-preserve-naive-datetime","workflow-managed xlsx output contains naive datetime create_datetime",run completes and workbook is committed,"Excel cell MUST be a date/datetime value (not a stringified text cell due to InMemoryRows str fallback)"
  r393,"xlsx-rows-aware-datetime-fails-like-openpyxl","workflow-managed xlsx output contains timezone-aware datetime",write/commit path runs,"system MUST NOT stringify; failure MUST be consistent with openpyxl timezone TypeError"
