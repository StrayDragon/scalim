kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  modify_requirement,r88,"workflow intermediate store MUST support a tabular row artifact (InMemoryRows)","当 workflow 需要在节点之间传递纯 Python 表格数据（而不是强制落盘/字符串化）时，系统 MUST 支持稳定表结构 `InMemoryRows`： - MUST 是明确表结构（header + 等长 rows），避免任意 object 图成为隐式耦合点。 - 细胞值域 MUST 允许任意 Python `object`（原样持有）；系统 MUST NOT 在 ROWS 中间态以 `FieldValue` 闭集做运行时门禁，也 MUST NOT 对未知类型静默 `str()`。 - 结构 MUST 为：`header: list[str]`（字段顺序 SSOT）；`rows: list[list[object]]`（每行与 header 等长、列序一致）。 - `FieldValue` / 内建 Excel 推荐类型集 MAY 作为文档与 opt-in 预检参考，但 MUST NOT 作为 ROWS 写入的硬门禁。",null,null,null
  modify_requirement,r912,"InMemoryRows MUST preserve cell objects without stringifying unknowns","系统 MUST 允许 `InMemoryRows` / `InMemoryRowsSink` 接受任意 Python `object` 细胞值并原样保留（含 `datetime`/`date`/`time`/`timedelta` 及库类型如 numpy/pandas 值）。系统 MUST NOT 在 ROWS 中间态对未知类型做 `str()` 兼容回退，也 MUST NOT 清除或改写时间值的 `tzinfo`。写出兼容性校验 MUST 延迟到 sink 边界（默认）或由 Python opt-in 预检按目标 sink accept set 在写入前 fail-fast。显式转换到 `InMemoryCsv` 时，值 MUST 继续使用与 `CSVSink` 等价的规范化（`None` -> \"\"，其余 -> `str(value)`）。",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  r88,"rows-accepts-arbitrary-objects","","InMemoryRowsSink 写入含 np.datetime64 与自定义 object 的行","MUST 成功追加且细胞类型保持原样（不得因非 FieldValue 而 TypeError 或 str()）"
  r912,"rows-no-silent-str-for-unknown","某字段值为自定义 object()","写入 InMemoryRowsSink","MUST 原样保留 object（MUST NOT str()；类型门禁不在 ROWS）"
  r912,"rows-preserves-np-datetime64","某字段值为 np.datetime64","写入 InMemoryRowsSink","MUST 成功保留 np.datetime64（失败若发生 MUST 在后续 sink/预检边界）"
  r912,"rows-sink-preserves-naive-datetime","某 output 字段值为 naive datetime(2024,1,2,3,4,5)","写入 InMemoryRowsSink","MUST 成功追加且保留 datetime 类型（不得变为 str）"
  r912,"rows-sink-preserves-aware-datetime","某 output 字段值为 timezone-aware datetime","写入 InMemoryRowsSink","MUST 成功追加且保留原对象（不得因 tzinfo 拒绝或去 tz）"
