kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r920,"built-in sinks MUST declare an accepted cell-type set","系统 MUST 为内建 tabular/file sinks（至少 Excel 与 CSV 语义路径）提供可查询的细胞类型接受约束（accept set 或等价谓词），其口径 MUST 对齐底层连接库的实际能力（例如 openpyxl 可绑定类型；CSV 为写出时 `str` 规范化）。accept set MUST NOT 声称会自动 coerce 未支持的库类型。`FieldValue` 推荐闭集 MAY 作为 Excel accept set 的默认文档/参考子集，但 MUST NOT 再作为 `InMemoryRows` 写入硬门禁。",null,null,null
  add_requirement,r921,"Python MAY enable opt-in sink type precheck before write","系统 MUST 提供 Python-only opt-in 开关（闭集 Enum 或 bool SSOT；默认关闭），用于在目标 sink 写出之前按该 sink 的 accept set 对细胞值做 TypeError fail-fast。启用时错误信息 MUST 包含 field 标识、实际类型与目标 sink。默认关闭时，系统 MUST 将类型不兼容错误延迟到 sink write/close（或底层库）边界。系统 MUST NOT 将该开关暴露为 YAML DSL knobs。",null,null,null
  add_requirement,r922,"file sink write failures MUST NOT promote half-written final artifacts","当内建 file sinks（CSV/Excel）或 workflow book 导出在写出/save/replace 失败时，系统 MUST NOT 将半成品 promote 为最终用户可见输出路径；系统 MUST 以 best-effort 清理 Scalim 管理的临时文件，并将原始错误向上抛出。成功路径仍 MUST 使用临时文件 + 原子替换（或 staging 再 publish）。本要求不强制改变 workflow staging 的 `keep_on_failure` 默认调试保留策略，但最终 publish 失败时最终路径 MUST NOT 留下半残文件。",null,null,null
  modify_requirement,r918,"Excel sinks MUST pass through temporal values without rewriting timezone","当内建 Excel / workbook / sheetbook 写出路径接收时间相关细胞值时，系统 MUST 允许 `datetime`/`date`/`time`/`timedelta`（及 Excel accept set 内的兼容值）原样交给 openpyxl（不得仅因类型而先 `str()`）。系统 MUST NOT 为兼容 openpyxl 而清除 `tzinfo`、转换为 UTC、或以其它方式改写用户时间值；timezone-aware 值若被 openpyxl 拒绝，该错误 MUST 向上暴露。`escape_excel_formula` MUST 仍仅对 `str` 做公式转义。",null,null,null
op_scenarios[6]{req_id,id,given,when,then}:
  r920,"excel-accept-set-documents-openpyxl-capable-types","","查询内建 Excel sink 的 accept set","MUST 覆盖 openpyxl 可写的推荐标量/时间类型且 MUST NOT 声称接受经探测不可写的 np.datetime64"
  r921,"precheck-off-defers-type-error-to-sink","opt-in 预检关闭且细胞含 openpyxl 拒绝的类型","执行写出","MUST 在 sink write/close 边界失败而非 ROWS 捕获时失败"
  r921,"precheck-on-fails-before-sink-write","opt-in 预检启用且目标为 Excel accept set","准备写入不被 accept 的类型","MUST 在首次写出前 TypeError，且最终输出路径 MUST NOT 被创建/替换"
  r922,"excel-save-failure-leaves-no-final-half-file","ExcelSink close 阶段 save 抛错","异常向上抛出","最终 output_path MUST NOT 存在半残 xlsx；Scalim temp MUST best-effort 清理"
  r918,"excel-passthrough-naive-datetime","Excel 路径接收 naive datetime","写出完成","单元格 MUST 为日期类型而非仅因框架 str() 产生的文本"
  r918,"excel-aware-datetime-surfaces-openpyxl-error","Excel 路径接收 timezone-aware datetime","写出","MUST 暴露与 openpyxl 一致的 TypeError（不得静默去 tz 或 str）"
