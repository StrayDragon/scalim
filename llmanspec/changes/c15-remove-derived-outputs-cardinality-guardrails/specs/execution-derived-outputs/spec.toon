kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  remove_requirement,r723,null,null,null,null,"`max_groups=0`(不设上限)时必须输出明确 warn"
  remove_requirement,r217,null,null,null,null,"distinct/去重状态的资源护栏"
  modify_requirement,r577,聚合状态资源控制,"系统 SHALL 不在进程内为派生输出聚合状态提供基数护栏(如 max_groups/max_distinct);聚合状态规模不受限,内存过载风险交由宿主系统层(如 OOM killer)兜底.",null,null,null
  modify_requirement,r242,meta/audit 的稳定指纹与结构化审计,"系统 MUST 为每个 derived target 生成稳定聚合指纹,并写入 meta sheet. 系统 MUST 满足: - meta 中 MUST 写入聚合指纹 - 当聚合发生错误时,系统 MUST 写入结构化 audit 行(仅脱敏信息) - 指纹 MUST 使用 `sha256` 计算,不得用于签名/认证等安全目的",null,null,null
  add_requirement,r800,派生输出不再提供基数护栏配置,"系统 MUST NOT 为派生输出提供基数护栏配置(max_groups / max_distinct / distinct_on_overflow / dedup_by.on_overflow);相关的 IR 字段、运行期构造参数、YAML 字段与警告 MUST 被移除. 高基数聚合的内存风险由宿主系统层兜底,框架不再在进程内做基数限界.",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  r577,无护栏默认运行,"派生输出未配置任何基数护栏","运行执行派生聚合","系统 MUST 不发出基数相关 warn,且 MUST 不对聚合键数量做进程内限界检查"
  r577,高基数场景不受限,"派生聚合键数量巨大","运行执行派生聚合","系统 MUST 不抛出基数超限错误;内存压力由宿主系统层处理"
  r242,聚合错误仍写审计,"派生聚合过程中发生非基数类错误","运行结束","系统 MUST 在 audit 写入结构化错误行,且 meta 中 MUST 写入聚合指纹"
  r800,残留护栏字段被拒绝,"YAML 配置中残留 max_groups / max_distinct / distinct_on_overflow / dedup_by.on_overflow 任一字段","解析该配置","系统 MUST fail-fast 报错并给出迁移提示(建议移除该字段)"
  r800,IR-构造不再接受护栏参数,"代码构造 DerivedGroupBySpec 或 DedupBySpec 时传入 max_groups/max_distinct/distinct_on_overflow/on_overflow","调用构造器","系统 MUST 报 TypeError(参数不存在)"
