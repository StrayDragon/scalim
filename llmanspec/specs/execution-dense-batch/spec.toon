kind: llman.sdd.spec
name: "execution-dense-batch"
purpose: "优化批次执行场景的内存占用与访问速度，通过 Dense 存储表示支持连续整数 row_id 的紧凑编码。 [scope-review-2026-07-13-c25-xlsx-ir-path-presence]"
valid_scope[1]: src/scalim/
requirements[3]{req_id,title,statement}:
  r35,Dense storage for contiguous integer row_id batches,"系统 MUST 支持在 row_id 连续整数场景下使用 Dense 存储表示以优化内存与性能；实现 MAY 在满足条件时启用该路径。 启用条件 MUST 可判定且可回退： - row_id MUST 为 int 且构成连续区间（存在可计算的 base_row_id 与 row_count） - 条件不满足时 MUST 回退到通用实现，语义不变"
  r279,Dense and generic BatchContext semantic equivalence,"无论是否启用 Dense path，BatchContext 对外语义 MUST 等价，包括但不限于： - set_field_value/get_field_value - delete_field/delete_row_from_field/delete_row_from_all_fields - disable_row - get_field_keys/get_field_count/get_all_rows_for_field"
  r403,Overlay context correctness under dense base context,"当 base context 为 Dense path 时，overlay context MUST 保持既有语义： - 读取优先 overlay，缺失回退 base - 写入仅落到 overlay，不影响 base"
scenarios[6]{req_id,id,given,when,then,feature}:
  r35,baseline,"","TODO: describe the trigger","TODO: describe the expected result",true
  r35,"non-contiguous-row-id-falls-back-safely","",执行路径出现非连续或非整数的 row_id,系统 MUST 回退到通用实现并保持行为一致,true
  r279,baseline,"","TODO: describe the trigger","TODO: describe the expected result",true
  r279,"set-get-delete-semantics-match","",在同一批次内对同一字段执行 set/get 与 delete（字段或行级删除）,Dense path 与通用实现结果 MUST 一致,true
  r403,baseline,"","TODO: describe the trigger","TODO: describe the expected result",true
  r403,"overlay-reads-fall-back-to-base","",base 已设置某字段值且 overlay 未覆盖该字段/行,overlay 读取 MUST 返回 base 值,true