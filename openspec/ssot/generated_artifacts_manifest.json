{
  "version": 1,
  "groups": [
    {
      "id": "project-constants",
      "generated_globs": [
        "src/scalim/_project_constants.py"
      ],
      "check": {
        "kind": "python_script",
        "script": "scripts/gen-project-constants.py",
        "args": [
          "--check"
        ]
      },
      "fix": "just gen-project-constants"
    },
    {
      "id": "yaml-dsl-schema",
      "generated_globs": [
        "src/scalim/dsl/by_yaml/schema/*.gen.json",
        "frontend/scalim-yaml-dsl-editor/public/schema/*.gen.json",
        "frontend/scalim-yaml-dsl-editor/src/schema/*.gen.json"
      ],
      "check": {
        "kind": "generate_and_git_diff",
        "generate": [
          {
            "script": "scripts/gen-yaml-dsl-schema.py",
            "args": []
          },
          {
            "script": "scripts/gen-yaml-dsl-editor-schema.py",
            "args": []
          }
        ],
        "diff_globs": [
          "src/scalim/dsl/by_yaml/schema/*.gen.json",
          "frontend/scalim-yaml-dsl-editor/public/schema/*.gen.json",
          "frontend/scalim-yaml-dsl-editor/src/schema/*.gen.json"
        ]
      },
      "fix": "just gen-yaml-dsl-editor-schema"
    },
    {
      "id": "docs-site",
      "generated_globs": [
        "docs/doc/**/*.gen.md"
      ],
      "check": {
        "kind": "python_script",
        "script": "scripts/gen-docs.py",
        "args": [
          "--check"
        ]
      },
      "fix": "just gen-docs"
    },
    {
      "id": "agent-skill",
      "generated_globs": [
        "artifacts/skills/**/*.gen.md",
        "artifacts/skills/**/*.gen.yaml",
        "artifacts/skills/*.build-manifest.json"
      ],
      "check": {
        "kind": "python_script",
        "script": "scripts/gen-agent-skill.py",
        "args": [
          "--validate"
        ]
      },
      "fix": "just gen-agent-skill"
    },
    {
      "id": "marimo-coverage",
      "generated_globs": [
        "notebooks/marimo/marimo_coverage.gen.md"
      ],
      "check": {
        "kind": "python_script",
        "script": "scripts/gen-marimo-coverage.py",
        "args": [
          "--check"
        ]
      },
      "fix": "just gen-marimo-coverage"
    }
  ]
}

